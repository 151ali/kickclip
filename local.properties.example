# Copy this file to local.properties (which is gitignored) and fill in
# your project's values. Never commit local.properties.

# sdk.dir=/path/to/android/sdk   # usually already set by Android Studio

# Supabase project URL and anon (public) key, from
# Project Settings -> API in your Supabase dashboard.
# The anon key is safe to ship in the app ONLY because Row Level Security
# policies on the tables restrict what it can read/write.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
